{
  "name": "@sniffy/landing",
  "version": "0.0.0",
  "private": true,
  "description": "Sniffy founder-facing demo UI (Next.js → Vercel).",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @sniffy/scraper run build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "doctor": "tsx scripts/doctor-morph.ts"
  },
  "dependencies": {
    "@reown/appkit": "1.7.8",
    "@reown/appkit-adapter-wagmi": "1.7.8",
    "@sniffy/scraper": "workspace:*",
    "@tanstack/react-query": "^5.62.10",
    "@tanstack/react-query-devtools": "^5.62.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "viem": "^2.21.55",
    "wagmi": "^2.14.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "supports-color": "^10.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
