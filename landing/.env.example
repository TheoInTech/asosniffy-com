# URL of the @sniffy/scraper backend. Defaults to the local Hono dev server.
NEXT_PUBLIC_SCRAPER_BASE_URL=http://localhost:3001

# Reown Cloud Project ID. Required for wallet connection. Get one at
# https://cloud.reown.com (free tier is sufficient for the hackathon demo).
NEXT_PUBLIC_REOWN_PROJECT_ID=

# ─────────── Morph network endpoints ───────────
# All fields below have working defaults baked into src/lib/morph-urls.ts —
# uncomment to override (e.g. for self-hosted RPCs or staging facilitators).

# Morph Hoodi (testnet) — chain id 2910
# NEXT_PUBLIC_MORPH_HOODI_RPC=https://rpc-hoodi.morph.network
# NEXT_PUBLIC_MORPH_HOODI_EXPLORER=https://explorer-hoodi.morphl2.io
# NEXT_PUBLIC_MORPH_HOODI_BRIDGE=https://bridge-hoodi.morphl2.io
# NEXT_PUBLIC_MORPH_HOODI_FAUCET=https://faucet-hoodi.morph.network

# Morph Mainnet — chain id 2818 (post-MVP; not required for the demo)
# NEXT_PUBLIC_MORPH_MAINNET_RPC=https://rpc.morphl2.io
# NEXT_PUBLIC_MORPH_MAINNET_EXPLORER=https://explorer.morphl2.io
# NEXT_PUBLIC_MORPH_MAINNET_BRIDGE=https://bridge.morphl2.io

# Official Morph x402 facilitator. Today supports `eip155:2818` (Mainnet) with
# scheme `exact` only. Hoodi support is pending — the scraper falls back to
# `fixture-receipt` mode for Hoodi runs so the demo end-to-end still works.
# NEXT_PUBLIC_MORPH_FACILITATOR_URL=https://morph-rails.morph.network/x402
