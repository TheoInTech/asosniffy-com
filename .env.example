# Sniffy — scraper environment variable template.
# Copy to `scraper/.env` (the dev script loads it via `tsx --env-file=.env`).
# `landing/.env.local` is configured separately — see `landing/.env.example`.
# Never commit a populated .env.

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Morph x402 payment adapter ───────────────────────────────────────────
# Selector — picks which Morph network the payment adapter targets at boot.
#   eip155:2818 → Morph Mainnet (default; official facilitator supports this)
#   eip155:2910 → Morph Hoodi testnet (facilitator does NOT list Hoodi in
#                 /v2/supported as of 2026-05-20 — use MORPH_FACILITATOR_MODE
#                 = fixture-receipt so the demo flow stays end-to-end)
MORPH_NETWORK=eip155:2818

MORPH_FACILITATOR_URL=https://morph-rails.morph.network/x402
# Three modes: morph-official | fixture-receipt | self-hosted-fallback
# morph-official requires ACCESS_KEY + SECRET_KEY below. fixture-receipt
# short-circuits verify+settle and synthesizes a 0xsample... transactionHash.
MORPH_FACILITATOR_MODE=morph-official
# Morph x402 Console credentials (https://morph-rails.morph.network/x402).
# Access key is sent in cleartext as MORPH-ACCESS-KEY; secret signs HMAC-SHA256.
# Only required when MORPH_FACILITATOR_MODE=morph-official.
MORPH_FACILITATOR_ACCESS_KEY=
MORPH_FACILITATOR_SECRET_KEY=

# Merchant wallet that receives x402 payments. EOA on the chosen network.
SNIFFY_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000

# ─── Payment asset (token contract) — per-network ─────────────────────────
# env.ts picks the active set based on MORPH_NETWORK. Both blocks below are
# read at boot; flip MORPH_NETWORK above to switch which one is used. Built-in
# defaults match these values when the env var is missing.

# Morph Mainnet (eip155:2818) — USDC (Bridged Standard)
SNIFFY_PAYMENT_ASSET_ADDRESS_MAINNET=0xCfb1186F4e93D60E60a8bDd997427D1F33bc372B
SNIFFY_PAYMENT_ASSET_DECIMALS_MAINNET=6
SNIFFY_PAYMENT_ASSET_EIP712_NAME_MAINNET=USDC
SNIFFY_PAYMENT_ASSET_EIP712_VERSION_MAINNET=2

# Morph Hoodi testnet (eip155:2910) — HoodiTestToken
SNIFFY_PAYMENT_ASSET_ADDRESS_HOODI=0xEcF966Cc754BC411E1F1106fbb4e343b835E85E4
SNIFFY_PAYMENT_ASSET_DECIMALS_HOODI=18
SNIFFY_PAYMENT_ASSET_EIP712_NAME_HOODI=HoodiTestToken
SNIFFY_PAYMENT_ASSET_EIP712_VERSION_HOODI=1.0

# Legacy un-suffixed vars are still honored as a fallback for the active
# network — uncomment if you need to override without using the suffixed names.
# SNIFFY_PAYMENT_ASSET_ADDRESS=
# SNIFFY_PAYMENT_ASSET_DECIMALS=
# SNIFFY_PAYMENT_ASSET_EIP712_NAME=
# SNIFFY_PAYMENT_ASSET_EIP712_VERSION=

# ─── CLI / MCP signer (testnet preferred — keep mainnet keys minimally funded) ─
SNIFFY_PRIVATE_KEY=

# ─── Cache (Upstash Redis or Railway Redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI synthesis (optional; falls back to deterministic templates) ───────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── App store provider tuning ────────────────────────────────────────────
ASO_DEFAULT_COUNTRY=US
ASO_DEFAULT_STORE=ios
ASO_USER_AGENT=ASOSniffy/0.1 (+https://sniffy.io)
