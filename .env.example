# Sniffy — environment variable template.
# Copy to `.env` (or `.env.local` for landing/) and fill in. Never commit a populated .env.

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8787

# ─── Public API base URL (landing/ reads this) ────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# ─── Morph x402 payment adapter (scraper/) ────────────────────────────────
# Default network is Morph Hoodi testnet (eip155:2910). Mainnet is post-MVP.
MORPH_NETWORK=eip155:2910
MORPH_FACILITATOR_URL=https://morph-rails.morph.network/x402
# Morph x402 Console credentials (two separate values: identifier + secret).
# Access key is sent in cleartext as MORPH-ACCESS-KEY; secret signs HMAC.
MORPH_X402_ACCESS_KEY=
MORPH_X402_SECRET_KEY=
# `live` calls Morph's facilitator; `fixture` short-circuits to a labeled fake receipt for /sample.
MORPH_X402_FACILITATOR_MODE=live

# Merchant wallet that receives x402 payments. EOA on Morph Hoodi.
SNIFFY_MERCHANT_ADDRESS=0x0000000000000000000000000000000000000000
# Token accepted for payment on Hoodi. HoodiTestToken per Morph's official Go example.
# Re-verify via GET /x402/v2/supported before mainnet.
SNIFFY_PAYMENT_ASSET_ADDRESS=0xEcF966Cc754BC411E1F1106fbb4e343b835E85E4
SNIFFY_PAYMENT_ASSET_DECIMALS=18
SNIFFY_PAYMENT_ASSET_EIP712_NAME=HoodiTestToken
SNIFFY_PAYMENT_ASSET_EIP712_VERSION=1.0
SNIFFY_PAYMENT_BASE_AMOUNT=0.05

# ─── Wallet (CLI / MCP testnet only — never paste a mainnet key) ──────────
SNIFFY_PRIVATE_KEY=

# ─── Cache (Upstash Redis or Railway Redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── AI synthesis (optional; falls back to deterministic templates) ───────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── App store provider tuning ────────────────────────────────────────────
ASO_DEFAULT_COUNTRY=US
ASO_DEFAULT_STORE=ios
ASO_USER_AGENT=ASOSniffy/0.1 (+https://sniffy.io)
