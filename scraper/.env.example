# ==========================================================================
# Sniffy scraper — production environment template
# ==========================================================================
# Copy to .env (or paste into Railway → Variables) and fill every TODO.
#
# Boot-time validation (scraper/src/env.ts):
#   - NODE_ENV=production + APPLE_SEARCH_ADS_ENABLED=true → all 5 ASA
#     credentials must be set, or the process exits at boot.
#   - NODE_ENV=production + RANK_HISTORY_ENABLED=true     → SNIFFY_HISTORY_HMAC_SECRET
#     must be ≥32 chars, or the process exits at boot.
#   - Payment endpoints throw at request time if SNIFFY_MERCHANT_ADDRESS is unset.
#
# To deploy WITHOUT a paid feature, flip its ENABLED flag to false rather than
# leaving creds blank. Defaults shown match scraper/src/env.ts.

# --- Runtime --------------------------------------------------------------
# Local dev: leave NODE_ENV=development and ALLOWED_ORIGINS as localhost.
# Railway/production: set NODE_ENV=production, the gosniffy.com hosts, and the
# api.gosniffy.com RESOURCE_BASE_URL via the Railway Variables panel.
NODE_ENV=development
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
RESOURCE_BASE_URL=http://localhost:3001
ENABLE_REQUEST_LOG=true

# --- Morph x402 payment ---------------------------------------------------
# Default: Mainnet. Switch to Hoodi by setting MORPH_NETWORK=eip155:2910 and
# uncommenting the _HOODI overrides below.
MORPH_NETWORK=eip155:2818
MORPH_FACILITATOR_MODE=morph-official
MORPH_FACILITATOR_URL=https://morph-rails.morph.network/x402
MORPH_FACILITATOR_ACCESS_KEY=    # TODO: morph_____
MORPH_FACILITATOR_SECRET_KEY=    # TODO: morph_____

# Merchant address — where x402 payments settle. Required for /diagnose.
SNIFFY_MERCHANT_ADDRESS=    # TODO: 0x___

# Active payment asset (Mainnet defaults — kept explicit for clarity).
SNIFFY_PAYMENT_ASSET_ADDRESS=0xCfb1186F4e93D60E60a8bDd997427D1F33bc372B  # USDC (Bridged Standard) on Morph Mainnet
SNIFFY_PAYMENT_ASSET_DECIMALS=6
SNIFFY_PAYMENT_ASSET_EIP712_NAME=USDC
SNIFFY_PAYMENT_ASSET_EIP712_VERSION=2

# Per-network overrides — precedence: suffixed > un-suffixed > built-in default.
# Mainnet (USDC) — already set above; suffixed variant is here for completeness.
# SNIFFY_PAYMENT_ASSET_ADDRESS_MAINNET=0xCfb1186F4e93D60E60a8bDd997427D1F33bc372B
# SNIFFY_PAYMENT_ASSET_DECIMALS_MAINNET=6
# SNIFFY_PAYMENT_ASSET_EIP712_NAME_MAINNET=USDC
# SNIFFY_PAYMENT_ASSET_EIP712_VERSION_MAINNET=2
# Hoodi testnet — uncomment if you flip MORPH_NETWORK to eip155:2910.
# SNIFFY_PAYMENT_ASSET_ADDRESS_HOODI=0xEcF966Cc754BC411E1F1106fbb4e343b835E85E4
# SNIFFY_PAYMENT_ASSET_DECIMALS_HOODI=18
# SNIFFY_PAYMENT_ASSET_EIP712_NAME_HOODI=HoodiTestToken
# SNIFFY_PAYMENT_ASSET_EIP712_VERSION_HOODI=1.0

# --- Cache (Upstash Redis, REST) ------------------------------------------
# In-memory fallback if either is unset — fine for local dev, NOT for prod
# (rate limits, sessions, rank history, and wallet index all need persistence).
UPSTASH_REDIS_REST_URL=    # TODO: https://___.upstash.io
UPSTASH_REDIS_REST_TOKEN=  # TODO: ___
CACHE_TTL_APP_METADATA=21600     # 6h  — title/icon/screenshots
CACHE_TTL_KEYWORD_RANK=3600      # 1h  — rank moves daily
CACHE_TTL_ANDROID_PREVIEW=86400  # 24h — preview-quality, low confidence
CACHE_TTL_FULL_REPORT=1800       # 30m — paid /diagnose response cache

# --- Resilient scraping (Phase 2) -----------------------------------------
# iTunes documented cap ~20/min/IP; we keep 2 slots in reserve.
ITUNES_RATE_LIMIT_PER_MIN=18
GOOGLE_PLAY_RATE_LIMIT_PER_MIN=5
RETRY_BASE_MS=250
RETRY_CAP_MS=8000
RETRY_ATTEMPTS=3

# Static IP / proxy (recommended on Railway: QuotaGuard).
PROXY_URL=                  # optional: https://user:pass@proxy.example.com:8080
PROXY_ENABLED_PROVIDERS=    # CSV provider names, e.g. "google-play,itunes"

# Google Play provider:
#   gplay-scraper  - public scraper (ToS-grey, ~1h ban risk under load)
#   serpapi        - paid, production-grade
#   disabled       - kill-switch (returns fixture/degraded)
GOOGLE_PLAY_PROVIDER=serpapi
SERPAPI_KEY=    # TODO: ___ (only required when GOOGLE_PLAY_PROVIDER=serpapi)

# --- Apple Search Ads (Phase 3 — iOS popularity signal) -------------------
# Set ENABLED=false to deploy without ASA. With ENABLED=true in production,
# ALL FIVE credentials below MUST be set or boot fails (env.ts:361).
APPLE_SEARCH_ADS_ENABLED=true
APPLE_SEARCH_ADS_CLIENT_ID=          # TODO: ___ (Apple Search Ads API)
APPLE_SEARCH_ADS_TEAM_ID=            # TODO: ___ (App Store Connect)
APPLE_SEARCH_ADS_KEY_ID=             # TODO: ___ (API key ID)
APPLE_SEARCH_ADS_ORG_ID=             # TODO: ___ (Ads organization ID)
# PEM-encoded EC private key — single line with literal \n separators.
# Generate: openssl ecparam -name prime256v1 -genkey -noout
APPLE_SEARCH_ADS_PRIVATE_KEY_PEM=    # TODO: -----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
APPLE_SEARCH_ADS_BASE_URL=https://api.searchads.apple.com/api/v5
APPLE_SEARCH_ADS_TOKEN_URL=https://appleid.apple.com/auth/oauth2/token
ASA_POPULARITY_CACHE_TTL_DAYS=7

# --- Rank history + schema drift (Phase 4) --------------------------------
RANK_HISTORY_ENABLED=true
SHAPE_DRIFT_ENABLED=true
# 32+ char secret. Generate: openssl rand -hex 32
SNIFFY_HISTORY_HMAC_SECRET=    # TODO: ___

# --- Localization gap analysis (Phase 5) ----------------------------------
LOCALIZATION_ENABLED=true
LOCALIZATION_STOREFRONTS=US,GB,JP,DE,BR,KR

# --- Rate limits (per wallet / per IP, Redis-backed) ----------------------
RL_DISABLED=false
RL_SAMPLE_PER_MIN=30
RL_SAMPLE_PER_DAY=300
RL_QUOTE_PER_MIN=10
RL_QUOTE_PER_DAY=60
RL_QUOTE_PER_TUPLE_PER_HOUR=3
RL_HISTORY_PER_MIN=60

# --- Cost circuit breaker -------------------------------------------------
# Trips free endpoints to 503 when iTunes 10-min usage exceeds this % of the
# per-minute budget; paid /diagnose keeps running.
COST_CIRCUIT_THRESHOLD_PCT=80

# --- Anti-abuse -----------------------------------------------------------
ABUSE_REQUIRE_SNIFFY_CLIENT=true
ABUSE_DENYLIST_UA=             # CSV lowercase substrings, e.g. "curl,python-requests"
# IP-hash salt for rate-limit persistence. Empty = randomized per boot
# (rate-limit counters reset on restart). Set to stable value for cross-restart persistence.
RL_IP_SALT=                    # optional: openssl rand -hex 16

# --- Wallet history / Trail (SIWE, Phase 7) -------------------------------
WALLET_HISTORY_ENABLED=true

# --- AI synthesis (Phase 4 — OpenAI) --------------------------------------
# Without OPENAI_API_KEY the orchestrator falls through to the deterministic
# template synthesizer (still ships a real report). Default gpt-5.4-mini costs
# ~$0.003 per /diagnose call — 2× under the $0.005–$0.020 envelope in
# business-model.md §3. Drop to OPENAI_MODEL=gpt-4o-mini (~$0.0004/call) for
# maximum margin; both models stay below budget.
OPENAI_API_KEY=    # TODO: sk-___
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=   # optional — for proxies or self-hosted OpenAI-compatible endpoints
