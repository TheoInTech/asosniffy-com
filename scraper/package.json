{
  "name": "@sniffy/scraper",
  "version": "0.0.0",
  "private": true,
  "description": "Sniffy ASO scraper API — Hono server + x402 payment adapter (Phase 02+).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: configured in Phase 02'",
    "baseline:shapes": "tsx scripts/baseline-shapes.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.12.0",
    "@hono/node-server": "^1.13.7",
    "@upstash/redis": "^1.34.3",
    "cheerio": "^1.2.0",
    "franc-min": "^6.2.0",
    "google-play-scraper": "10.1.2",
    "hono": "^4.6.14",
    "nanoid": "^5.1.11",
    "openai": "^4.104.0",
    "playwright-core": "^1.60.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "msw": "^2.14.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
