{
  "name": "@sniffy/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Sniffy ASO API (x402-paywalled on Morph).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: configured post-MVP'",
    "test": "vitest run",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration.test.ts"
  },
  "dependencies": {
    "@x402/core": "^2.12.0",
    "@x402/evm": "^2.12.0",
    "@x402/fetch": "^2.12.0",
    "zod": "^3.24.1"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sniffy/scraper": "workspace:*",
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "viem": "^2.21.55",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
