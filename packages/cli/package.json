{
  "name": "@gosniffy/cli",
  "version": "0.2.0",
  "description": "Command-line client for the Sniffy ASO API. `npx sniffy quote|diagnose|sample`.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sniffy": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: configured post-MVP'",
    "test": "vitest run"
  },
  "dependencies": {
    "@gosniffy/sdk": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@sniffy/scraper": "workspace:*",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
